{
  "version_branches": [
    "mc/1.20.1",
    "mc/1.21.1"
  ],
  "java_versions": [17, 21],
  "environment": "both",
  "snapshot": {
    "enabled": true,
    "retention_days": 30
  },
  "auto_port": {
    "enabled": true,
    "draft_on_conflict": true
  },
  "github_release_title_format": "{MOD_VERSION}+mc{MC_VERSION}",
  "mod_release_title_format": "{MOD_NAME} {MOD_VERSION}+mc{MC_VERSION} ({LOADER_NAME})",
  "discord": {
    "release": {
      "enabled": true,
      "title_format": "{MOD_NAME} {MOD_VERSION} - Minecraft {MC_VERSIONS} {PLATFORMS}",
      "changelog_limit": 0,
      "color": "#43B581",
      "prerelease_color": "#FAA61A",
      "mention": "",
      "thumbnail": "",
      "footer": "",
      "crosspost": false,
      "buttons": [
        { "label": "CurseForge", "url": "{CURSEFORGE_URL}" },
        { "label": "Modrinth", "url": "{MODRINTH_URL}" },
        { "label": "GitHub", "url": "{RELEASE_URL}" }
      ]
    },
    "dev": {
      "enabled": true,
      "events": {
        "push": true,
        "pull_request": true,
        "pull_request_review": false,
        "issues": true,
        "issue_comment": false,
        "discussion": false,
        "release": true,
        "workflow_failure": true,
        "star": false,
        "fork": false
      },
      "branches": [],
      "max_commits": 10,
      "skip_bots": true,
      "skip_merge_commits": false
    },
    "issues": {
      "enabled": true,
      "thread_title_format": "#{NUMBER} {TITLE}",
      "labels_as_tags": true,
      "tag_map": {},
      "default_tags": [],
      "mirror_github_comments": true,
      "mirror_discord_messages": false,
      "mirror_edits": true,
      "close_thread_on_close": true,
      "lock_thread_on_close": false
    }
  },
  "changelog_categories": [
    {
      "inputs": ["added", "add", "✨"],
      "output": "Added"
    },
    {
      "inputs": ["fixed", "fix", "🐛"],
      "output": "Fixed"
    },
    {
      "inputs": ["changed", "change", "♻️"],
      "output": "Changed"
    },
    {
      "inputs": ["removed", "remove", "🔥"],
      "output": "Removed"
    },
    {
      "inputs": ["updated", "update", "⬆️"],
      "output": "Updated"
    }
  ]
}
