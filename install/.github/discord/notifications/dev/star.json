{
  "description": "Someone starred the repository. Off by default; set enabled to true if you like it.",
  "enabled": false,
  "target": "dev",

  "on": {
    "event": "watch",
    "action": ["started"],
    "skip_bots": true
  },

  "message": {
    "embeds": [
      {
        "author": {
          "name": "{ACTOR}",
          "url": "{ACTOR_URL}",
          "icon_url": "{ACTOR_AVATAR}"
        },
        "title": "{ACTOR} starred {REPO_NAME}",
        "url": "{REPO_URL}",
        "color": "{COLOR_WARNING}",
        "description": "{STARS} stars in total."
      }
    ]
  }
}
