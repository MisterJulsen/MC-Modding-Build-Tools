{
  "description": "Someone forked the repository. Off by default.",
  "enabled": false,
  "target": "dev",

  "on": {
    "event": "fork",
    "skip_bots": true
  },

  "message": {
    "embeds": [
      {
        "author": {
          "name": "{ACTOR}",
          "url": "{ACTOR_URL}",
          "icon_url": "{ACTOR_AVATAR}"
        },
        "title": "🍴 New fork: {FORK_NAME}",
        "url": "{FORK_URL}",
        "color": "{COLOR_NEUTRAL}",
        "description": "{FORK_COUNT} forks in total."
      }
    ]
  }
}
